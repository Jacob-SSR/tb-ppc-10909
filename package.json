{
  "name": "tb-ppc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "migrate:status": "node --env-file-if-exists=.env.local scripts/migrate.ts --status",
    "test:db": "node --env-file-if-exists=.env.local --test \"tests/db/*.dbtest.ts\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "googleapis": "^187.0.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
