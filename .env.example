# คัดลอกเป็น .env.production (บน .58) หรือ .env.local (dev) แล้วใส่ค่าจริง — ห้าม commit ไฟล์ค่าจริง

# ── MySQL ของโปรเจกต์ (ppc_tb) ─────────────────────────────────────────────
# ใน compose TB_DB_HOST ถูกตั้งเป็น mysql ให้แล้ว; dev บนเครื่องใช้ 127.0.0.1
TB_DB_HOST=127.0.0.1
TB_DB_PORT=3306
TB_DB_NAME=ppc_tb
TB_DB_USER=tb_app
TB_DB_PASSWORD=          # = TB_APP_PASSWORD ใน .env.mysql
TB_DB_POOL_SIZE=10
# dev เท่านั้น: npm run migrate / test:db (production ใช้ .env.mysql ผ่าน service migrate)
TB_MIGRATE_PASSWORD=

# ── HOSxP (อ่านอย่างเดียว บัญชีที่มีแค่ SELECT) ────────────────────────────
HOSXP_DB_HOST=
HOSXP_DB_PORT=3306
HOSXP_DB_NAME=
HOSXP_DB_USER=
HOSXP_DB_PASSWORD=
HOSXP_DB_POOL_SIZE=3

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Session (Phase 2) — สุ่มอย่างน้อย 32 ตัวอักษร: openssl rand -base64 48 ──
SESSION_SECRET=

# ── Google Sheet mirror (Phase 6) ──────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
TB_SPREADSHEET_ID=

# ── LINE OA แจ้งเตือน (Phase 6) ────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
