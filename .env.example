# คัดลอกเป็น .env.production (บน .58) หรือ .env.local (dev) แล้วใส่ค่าจริง — ห้าม commit ไฟล์ค่าจริง

# ── MySQL ของโปรเจกต์ (ppc_tb) ─────────────────────────────────────────────
# ใน compose TB_DB_HOST ถูกตั้งเป็น mysql ให้แล้ว; dev บนเครื่องใช้ 127.0.0.1
TB_DB_HOST=127.0.0.1
TB_DB_PORT=3306
TB_DB_NAME=ppc_tb
TB_DB_USER=tb_app
# = TB_APP_PASSWORD ใน .env.mysql
TB_DB_PASSWORD=
TB_DB_POOL_SIZE=10
# dev เท่านั้น: npm run migrate / test:db (production ใช้ .env.mysql ผ่าน service migrate)
TB_MIGRATE_PASSWORD=

# ── HOSxP (อ่านอย่างเดียว บัญชีที่มีแค่ SELECT) ────────────────────────────
HOSXP_DB_HOST=
HOSXP_DB_PORT=3306
HOSXP_DB_NAME=
HOSXP_DB_USER=
HOSXP_DB_PASSWORD=
HOSXP_DB_POOL_SIZE=3

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Session (Phase 2) — สุ่มอย่างน้อย 32 ตัวอักษร: openssl rand -base64 48 ──
SESSION_SECRET=

# ── Google Sheet mirror (MySQL → Sheet ทางเดียว) ───────────────────────────
# service account ต้องได้สิทธิ์ "ผู้แก้ไข" ในไฟล์ (แชร์ไฟล์ให้อีเมลนี้) — ระบบจะล็อกแท็บ DB_* ให้แก้ได้เฉพาะ service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
TB_SPREADSHEET_ID=

# ── แจ้งนัดทุกเช้า 07:00 + แจ้งคิว Sheet ค้าง ──────────────────────────────
# LINE Official Account (Messaging API) — broadcast ถึงทุกคนที่เพิ่มเพื่อน
LINE_CHANNEL_ACCESS_TOKEN=
# อีเมล (เว้นว่าง = ไม่ส่งอีเมล) ผู้รับตั้งในหน้า "ตั้งเป้าหมาย"
SMTP_HOST=
SMTP_PORT=587
# 1 = SSL (พอร์ต 465)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── อื่นๆ ───────────────────────────────────────────────────────────────────
# ปิดงานเบื้องหลัง (sync Sheet / แจ้งเตือน) — ปกติไม่ต้องตั้ง
# WORKER=0
# ตั้งเมื่อเปิดผ่าน https (Cloudflare Tunnel)
# COOKIE_SECURE=1
